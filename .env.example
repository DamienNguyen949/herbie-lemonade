# Copy this file to .env (same folder) and fill in your Jira login.
# Never share or upload .env: it holds your API token.
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens

JIRA_SITE=https://your-site.atlassian.net
JIRA_PROJECT=KAN
JIRA_EMAIL=you@example.com
JIRA_TOKEN=paste-your-token-here
